{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "triage vignettes (Test 5)",
  "description": "One file per split. Dev: llm/eval/triage_vignettes_dev.json (llm-dev and qa-engineer may tune on it). Held-out: labels/heldout/ (research-pm writes the keys; never shown to llm-dev). The key is written first, then the patient words from it (llm/eval/README.md). symptoms are the verified extraction the triage step would receive: null = unanswered.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "split", "protocol_version", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "split": {"enum": ["dev", "heldout", "sanity"]},
    "protocol_version": {"type": "string", "description": "triage_protocol.yaml version the keys were written against"},
    "note": {"type": "string"},
    "cases": {"type": "array", "items": {"$ref": "#/definitions/case"}}
  },
  "definitions": {
    "level": {"enum": ["EMERGENCY", "URGENT", "SOON", "ROUTINE"]},
    "fdi": {"type": "string", "pattern": "^[1-4][1-8]$"},
    "bool_or_null": {"type": ["boolean", "null"]},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "symptoms", "visual_summary", "patient_words", "dentist_label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]{3}$"},
        "key": {"$ref": "#/definitions/key"},
        "symptoms": {"$ref": "#/definitions/symptoms"},
        "visual_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["images_usable", "flagged_teeth", "unexpected_missing_teeth"],
          "properties": {
            "images_usable": {"type": "boolean"},
            "flagged_teeth": {"type": "array", "items": {"$ref": "#/definitions/fdi"}, "uniqueItems": true},
            "unexpected_missing_teeth": {"type": "array", "items": {"$ref": "#/definitions/fdi"}, "uniqueItems": true}
          }
        },
        "patient_words": {
          "type": "array", "items": {"type": "string"},
          "description": "User turns only, verbatim. Empty until the text is generated from the key (P7)."
        },
        "paraphrases": {
          "type": "array", "items": {"type": "array", "items": {"type": "string"}},
          "description": "Optional alternative patient_words with the same key, for the stability measure."
        },
        "style": {"enum": ["plain", "vague", "non_native", "self_correcting", "verbose", "terse",
                           "injection", null]},
        "ambiguous": {"type": "boolean",
                      "description": "P7 §6: text fair but genuinely ambiguous; reported separately, excluded from nothing."},
        "dentist_label": {
          "description": "Blind dentist label. Filled by qa-engineer only after labelling is complete; never by hand-editing to match a result.",
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["level"],
             "properties": {"level": {"oneOf": [{"$ref": "#/definitions/level"}, {"const": "NOT_ENOUGH_INFO"}]},
                            "reason": {"type": "string"}, "rater": {"type": "string"}}}
          ]
        }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "criteria_met", "author", "boundary", "stratum"],
      "properties": {
        "level": {"$ref": "#/definitions/level"},
        "criteria_met": {"type": "array", "items": {"type": "string"}, "uniqueItems": true,
                         "description": "Every protocol criterion that holds, structured and narrative. The level must equal the most urgent of them (ROUTINE if none)."},
        "emergency_route": {"enum": ["medical", "dental", "either", null]},
        "author": {"type": "string"},
        "boundary": {"type": "boolean", "description": "A deliberately close call (plan §4: at least 40%)."},
        "stratum": {"type": "string", "description": "What the case probes, e.g. 'pain_relief_not_helped'."},
        "rationale": {"type": "string"}
      }
    },
    "symptoms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version"],
      "properties": {
        "schema_version": {"enum": ["1.0", "1.1", "1.2"]},
        "pain_present": {"$ref": "#/definitions/bool_or_null"},
        "pain_triggers": {"type": ["array", "null"], "uniqueItems": true,
                          "items": {"enum": ["cold", "hot", "sweet", "biting", "spontaneous", "unknown"]}},
        "pain_lingers_over_30s": {"$ref": "#/definitions/bool_or_null"},
        "pain_wakes_at_night": {"$ref": "#/definitions/bool_or_null"},
        "pain_on_biting": {"$ref": "#/definitions/bool_or_null"},
        "swelling": {"$ref": "#/definitions/bool_or_null"},
        "fever": {"$ref": "#/definitions/bool_or_null"},
        "difficulty_swallowing_or_breathing": {"$ref": "#/definitions/bool_or_null"},
        "recent_trauma": {"$ref": "#/definitions/bool_or_null"},
        "bleeding_gums": {"$ref": "#/definitions/bool_or_null"},
        "location": {"enum": ["upper_left", "upper_right", "lower_left", "lower_right",
                              "front", "generalised", "unknown", null]},
        "duration_days": {"type": ["integer", "null"], "minimum": 0},
        "notes": {"type": ["string", "null"]},
        "pain_relief_effect": {"enum": ["helped", "not_helped", "not_tried", null]},
        "pain_severity": {"enum": ["mild", "moderate", "severe", null]},
        "systemically_unwell": {"$ref": "#/definitions/bool_or_null"},
        "swelling_features": {"type": ["array", "null"], "uniqueItems": true,
                              "items": {"enum": ["spreading_to_eye_or_neck", "worsening_fast", "worsening_slowly",
                                                 "limited_mouth_opening", "tongue_raised", "none"]}},
        "trauma_features": {"type": ["array", "null"], "uniqueItems": true,
                            "items": {"enum": ["head_injury_or_passed_out", "tooth_knocked_out", "bite_changed", "none"]}},
        "bleeding_uncontrolled": {"$ref": "#/definitions/bool_or_null"},
        "chest_pain_or_breathless": {"$ref": "#/definitions/bool_or_null"},
        "exceeded_pain_relief_dose": {"$ref": "#/definitions/bool_or_null"},
        "recent_extraction": {"$ref": "#/definitions/bool_or_null"},
        "persistent_ulcer": {"$ref": "#/definitions/bool_or_null"},
        "broken_filling_or_tooth": {"$ref": "#/definitions/bool_or_null"},
        "pus_or_discharge": {"$ref": "#/definitions/bool_or_null"}
      }
    }
  }
}
